<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%-include('../inc/Top.ejs') %>
    <hr />
    <div class="container">
        <h2>장바구니</h2>
        <hr />
        <div class="container">
            <h2>상품 목록</h2>
            <hr />
            <%-include('./ShopNav.ejs') %>
            <hr />
            <table class="table">
                <tr>
                    <th>ID</th>
                    <th>NAME</th>
                    <th>PRICE</th>
                    <th>YEAR</th>
                    <th>DELETE</th>
                </tr>
                <%
                    cart.forEach((car) => {
                        
                %>
                <tr>
                    <td><%= car._id %></td>
                    <td><a href="/shop/detail?_id=<%= car._id %>"><%= car.name %></a></td>
                    <td><%= car.price %></td>
                    <td><%= car.year %></td>
                    <td>
                        <form action="/shop/cart" method="post">
                            <input type="hidden" name="_id" value="<%=car._id %>">
                            <input class="btn btn-danger" type="submit" value="DELETE">
                        </form>
                    </td>
                </tr>
                <%
                });
                %>
            </table>
        </div>
    </div>
</body>
</html>