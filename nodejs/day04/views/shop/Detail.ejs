<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <%-include('../inc/Top.ejs') %>
    <hr />
    <div class="container">
        <h2>상세보기</h2>
        <hr />
        <table>
            <tr>
                <th>ID</th>
                <td><%= car._id%></td>
            </tr>
            <tr>
                <th>NAME</th>
                <td><%= car.name%></td>
            </tr>
            <tr>
                <th>PRICE</th>
                <td><%= car.price%></td>
            </tr>
            <tr>
                <th>YEAR</th>
                <td><%= car.year%></td>
            </tr>
            <tr>
                <th>COMPANY</th>
                <td><%= car.company%></td>
            </tr>
            <tr>
                <th>PHOTO</th>
                <%
                    car.photos.forEach((photo) => {
                %>
                <td><img width="200" src="../<%=photo.fileName%>" alt="<%=photo.originalName%>"></td>
                <%
                    });
                %>
            </tr>
        </table>
        <a href="/shop/modify?_id=<%= car._id %>">수정</a> | 
        <a href="/shop/delete?_id=<%= car._id %>">삭제</a> |
        <a href="/shop/cart?_id=<%= car._id %>">담기</a> |
        <%-include('./ShopNav.ejs') %>
    </div>
</body>
</html>